# Comma-separated list of allowed frontend origins.
# Later: https://<actual-vercel-domain>
FRONTEND_URL=http://localhost:8443
ENVIRONMENT=development

# Supabase PostgreSQL connection string (placeholder - NEVER commit the real one).
# Supabase dashboard -> Connect -> Session pooler (or Direct connection).
# Use the session pooler / direct connection (port 5432) for Alembic migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<your-database-password>@<region>.pooler.supabase.com:5432/postgres
